# ============================================================
# VeriProof Backend — Environment Configuration Template
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to Git. It is already in .gitignore.
# ============================================================

PROJECT_NAME="VeriProof API"
API_V1_STR="/api/v1"

# ─── Database ────────────────────────────────────────────────
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL="postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/veriproof"

# ─── JWT / Security ─────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY="YOUR_SUPER_SECRET_KEY_HERE_CHANGE_ME_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Application Environment ────────────────────────────────
ENVIRONMENT="development"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ─── Mail / SMTP Configuration ───────────────────────────────
# Set real credentials to enable live OTP email delivery.
# If SMTP_HOST is absent or set to "smtp.example.com", the API returns HTTP 503.
#
# ── Gmail SMTP (App Password) ────────────────────────────────
# Requirements:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Create an App Password named "VeriProof" (or any label).
#   4. Copy the 16-character password Google generates.
#   5. Paste it as SMTP_PASSWORD below (no spaces).
#   6. The SMTP_USER and SMTP_FROM_EMAIL must match your Gmail address.
#   7. Restart the backend after saving .env.
#
# Port 587 = STARTTLS (recommended for Gmail)
# Port 465 = SSL/TLS (implicit TLS — also supported)
#
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your.gmail.address@gmail.com"
SMTP_PASSWORD="xxxxxxxxxxxxxxxxxxxx"
SMTP_USE_TLS=True
SMTP_TLS=True
SMTP_FROM_EMAIL="your.gmail.address@gmail.com"
EMAILS_FROM_EMAIL="your.gmail.address@gmail.com"
EMAILS_FROM_NAME="VeriProof Platform"

# ─── Field-level Encryption (AES-256-GCM) ───────────────────
# Optional. Leave blank if not using encrypted document metadata fields.
# FIELD_ENCRYPTION_KEY=""

# ─── Private Organization Document Storage ──────────────────
# Keep this directory outside public frontend/static folders.
# STORAGE_DIR="C:/veriproof-private/documents"
MAX_ORGANIZATION_DOCUMENT_SIZE_BYTES=10485760
MAX_DOCUMENT_SIZE_BYTES=15728640
PUBLIC_VERIFICATION_MAX_REQUESTS_PER_MINUTE=120
PUBLIC_COMPARISON_MAX_REQUESTS_PER_MINUTE=20
DOCUMENT_SIGNING_KEY_ID="veriproof-ecdsa-p256-2026-01"
# Optional trusted verification-key ring for retained signatures after key rotation (JSON object: key ID -> PEM public key).
# DOCUMENT_SIGNING_PUBLIC_KEYS_JSON='{"veriproof-ecdsa-p256-2026-01":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----\\n"}'
# Required in production. Development may create this persistent key once if missing.
# DOCUMENT_SIGNING_PRIVATE_KEY_PATH="C:/veriproof-private/keys/document-signing.pem"
PUBLIC_FRONTEND_URL="http://localhost:5173"

# ─── Super Admin Bootstrap (Optional CLI defaults) ──────────
# Used only by backend/bootstrap_admin.py for non-interactive provisioning.
# Leave commented in production; use getpass interactive mode instead.
# SUPER_ADMIN_NAME="System Administrator"
# SUPER_ADMIN_EMAIL="admin@veriproof.com"
# SUPER_ADMIN_PASSWORD="YourStrongPassword123!"
